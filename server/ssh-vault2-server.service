[Unit]
Description=ssh-vault2 self-hosted server
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ssh-vault2-server
ExecStart=/usr/bin/docker compose -f /opt/ssh-vault2-server/compose.yaml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f /opt/ssh-vault2-server/compose.yaml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
